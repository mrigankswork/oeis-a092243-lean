/-- The gcd test: `isP Q n = true` iff `gcd n Q = 1`. -/
def isP (Q n : Nat) : Bool := Nat.beq (Nat.gcd n Q) 1

/-- Score state: `(previous-but-one prime, previous prime, score, number of primes so far)`. -/
abbrev State := Nat × Nat × Int × Nat

/-- One step of the tug-of-war score when the next prime is `c`. The increment is exactly the
summand of `a`: the sign of (new gap − previous gap), with the same ℕ-subtraction and casts. -/
def step (s : State) (c : Nat) : State :=
  (s.2.1, c, s.2.2.1 + (((c - s.2.1 : Nat) : Int) - ((s.2.1 - s.1 : Nat) : Int)).sign, s.2.2.2 + 1)

/-- A certificate entry: block start, block length, number of sieving primes, end state. -/
abbrev Cert := Nat × Nat × Nat × State

/-- The numbers in the block of `c` that pass the gcd test. -/
def blockFilter (c : Cert) : List Nat := (List.range' c.1 c.2.1).filter (isP (spProd c.2.2.1))

/-- Check a list of certificate entries in order, starting from state `s`: each block's fold
